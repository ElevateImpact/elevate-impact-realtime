# Database Connection
# Railway format example: postgresql://postgres:password@host:port/database
# Local format example: postgresql://postgres:postgres@localhost:5432/elevate
DATABASE_URL=postgresql://postgres:password@localhost:5432/elevate_realtime

# SignalR / API config (see AGENTS.md §H-4a key split)
# PUBLIC browser key: equals the web service's PUBLIC_SIGNALR_KEY; opens the hub only.
SIGNALR_API_KEY=your_development_public_key_here
# SERVER-only notify key (>= 32 chars, must differ from SIGNALR_API_KEY). Unset = legacy mode.
SIGNALR_SERVER_KEY=
# Transition switch: true keeps accepting the public key on /api/notify (logs H4_LEGACY_NOTIFY_KEY); false = enforced.
# REQUIRED (true/false) whenever SIGNALR_SERVER_KEY is set; false with SIGNALR_SERVER_KEY blank also refuses to boot.
SIGNALR_NOTIFY_ACCEPT_PUBLIC_KEY=

# Hub identity (see AGENTS.md §H-14). SERVER-only HMAC key for signed hub tokens (>= 32 chars,
# must differ from SIGNALR_API_KEY and SIGNALR_SERVER_KEY; same value on the web service). Unset = legacy.
SIGNALR_HUB_TOKEN_KEY=
# true = transition (token OR public key + ?userId=, logs H14_LEGACY_HUB_IDENTITY); false = enforced (token only).
# REQUIRED (true/false) whenever SIGNALR_HUB_TOKEN_KEY is set; false with the key blank refuses to boot.
SIGNALR_HUB_ACCEPT_ASSERTED_USERID=
# Rotation only: the outgoing hub key, still accepted while web switches over (logs H14_HUB_TOKEN_PREVIOUS_KEY).
# Leave blank otherwise. See AGENTS.md §H-14 rotation.
SIGNALR_HUB_TOKEN_KEY_PREVIOUS=

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Port to bind
PORT=8080
